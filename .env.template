# DevQuest Backend — Environment Configuration
# Copy this to .env on the OCI instance and fill in real values
# DO NOT commit .env (it's gitignored)

# ── PostgreSQL ──────────────────────────────────────────────
# On OCI we'll point this at a container postgres OR managed Oracle DB
DB_HOST=postgres
DB_USERNAME=portfolio_app
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# Spring datasource is built from above:
#   spring.datasource.url=jdbc:postgresql://${DB_HOST}:5432/portfolio

# ── Redis (Upstash) ─────────────────────────────────────────
# Get from https://console.upstash.com (free tier)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=true

# ── Steam Web API ───────────────────────────────────────────
# Get a key at https://steamcommunity.com/dev/apikey (free)
# Leave blank to use MOCK_GAMES fallback (CS2, GTA V hardcoded)
STEAM_API_KEY=
STEAM_ID=

# ── Photo Uploads ───────────────────────────────────────────
# Path inside container; mount a Docker volume to this path
UPLOADS_DIR=/app/uploads
