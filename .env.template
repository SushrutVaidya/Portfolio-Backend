# DevQuest Backend — Environment Configuration
# Copy this to .env on the OCI instance and fill in real values
# DO NOT commit .env (it's gitignored)

# ── PostgreSQL ──────────────────────────────────────────────
# Used BOTH by the postgres container at init AND by the backend at connect.
# Keep DB_* and POSTGRES_* in sync (same db name, same user, same password).
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio_app
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# Backend-side equivalents (read by Spring boot)
DB_HOST=postgres
DB_USERNAME=portfolio_app
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# ── Redis (Upstash) ─────────────────────────────────────────
# Get from https://console.upstash.com (free tier)
# Leave blank for in-memory fallback (rickroll counter resets on restart)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=true

# ── Steam Web API ───────────────────────────────────────────
# Get a key at https://steamcommunity.com/dev/apikey (free)
# Leave blank to use MOCK_GAMES fallback (CS2, GTA V hardcoded)
STEAM_API_KEY=
STEAM_ID=

# ── Photo Uploads ───────────────────────────────────────────
# Path inside the backend container; docker-compose mounts a named
# volume at this path so photos persist across container restarts.
UPLOADS_DIR=/app/uploads

# ── Auth ────────────────────────────────────────────────────
# HMAC secret for the weak-signature token scheme. Generate a fresh one
# per deploy:  openssl rand -base64 48
# Rotating this invalidates ALL user tokens — everyone has to re-register.
AUTH_HMAC_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ── Domain (used by certbot + nginx-proxy) ─────────────────
DOMAIN=sushrutvaidya.in
CERTBOT_EMAIL=you@example.com

